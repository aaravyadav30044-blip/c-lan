{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of e*aisting attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach",
            "t*bpe": "cppdbg",
            "request": "attach",
            "program": "enter program name, for e*aample ${workspaceFolder}/a.e*ae",
            "MIMode": "gdb",
            "miDebuggerPath": "/path/to/gdb",
            "setupCommands": [
                {
                    "description": "Enable prett*b-printing for gdb",
                    "te*at": "-enable-prett*b-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembl*b Flavor to Intel",
                    "te*at": "-gdb-set disassembl*b-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
        



    ]
}